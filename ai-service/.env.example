# Vector Store & Database (100% PGVector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chess_db
VECTOR_COLLECTION=knowledge_doc
RETRIEVAL_SCORE_THRESHOLD=0.5

# CORS Origins
CORS_ORIGINS=["http://localhost:5173"]

# LLM Providers ("groq" | "openai" | "ollama")
LLM_PROVIDER=groq
ROUTER_PROVIDER=ollama
VISION_PROVIDER=

# Groq Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Ollama Local Configuration (http://localhost:11434 on host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_ROUTER_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# Embedding Configuration ("huggingface" | "huggingface_local" | "local" | "openai")
EMBEDDING_PROVIDER=huggingface_local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
HUGGINGFACE_API_KEY=

# Reranker Configuration ("huggingface_local" | "huggingface" | "local" | "jina" | "none")
RERANKER_PROVIDER=huggingface_local
# models: cross-encoder/ms-marco-MiniLM-L-6-v2, BAAI/bge-reranker-v2-m3, jina-reranker-v3.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_CANDIDATES_K=8
RERANKER_SCORE_THRESHOLD=0.05
RERANKER_TIMEOUT_SECONDS=10.0

# Jina AI Configuration
# Get your Jina AI API key for free: https://jina.ai/?sui=apikey
JINA_API_KEY=your-jina-api-key

# Authentication
JWT_SECRET=your-jwt-secret-key

# LangSmith Observability & Tracing (Optional)

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=viechess-ai-service
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

